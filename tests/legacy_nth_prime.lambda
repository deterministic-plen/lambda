nth-prime → (λtarget.
  if (== target 1) 
  then 2
  else 
    letloop find = (λnum count t.
      letloop check = (λd.
        if (≺ num (⊗ d d)) 
        then 
          if (≡ (⊕ count 1) t) 
          then num
          else find (⊕ num 2) (⊕ count 1) t
        else if (≡ 0 (⊙ num d)) 
        then find (⊕ num 2) count t
        else check (⊕ d 2)
      ) in check 3
    ) in find 3 1 target
)
(nth-prime 670000)