; Parallel prime counting: each block of 65,536 candidates is independent.
include "lib/prime.lambda"

nth-prime-par → (λn.
  limit → (upper-bound n)
  blocks → (float->int (/ (+ (int->float limit) 65535.0) 65536.0))
  counts → (pmap count-block (range 0 blocks))
  loc → (find-block counts n)
  b → (head loc)
  k → (head (tail loc))
  (find-in-block b k))

(nth-prime-par 670000)
