; Chunked segmented sieve of Eratosthenes.
; Base primes live in a flat int array; blocks are counted in chunks by
; arrayi-pmap-chunk into a flat result array.  Only the selected chunk is
; rescanned, and only the selected block is materialised as a mask.
include "lib/prime.lambda"

; primes up to `limit`, stored in a zero-sentinel int array
build-base → (λa i j limit.
  if (> i limit)
  then a
  else if (is-prime i)
  then (build-base (arrayi-set a j i) (+ i 1) (+ j 1) limit)
  else (build-base a (+ i 1) j limit))

nth-prime-sieve → (λn.
  limit → (upper-bound n)
  root → (float->int (sqrt (int->float limit)))
  ps → (immortalize (build-base (arrayi (+ root 1) 0) 2 0 root))
  blocks → (float->int (/ (+ (int->float limit) 63.0) 64.0))
  chunk-size → 32
  chunks → (/ (+ blocks (- chunk-size 1)) chunk-size)

  mark-prime → (λ p lo mask.
    p2 → (* p p)
    rem → (% lo p)
    first0 → (if (== rem 0) then lo else (+ lo (- p rem)))
    first → (if (< first0 p2) then p2 else first0)
    mark → (λoff mask.
      if (>= off 64)
      then mask
      else (mark (+ off p) (& mask (! (shl 1 off)))))
    (mark (- first lo) mask))

  block-mask → (λb.
    lo → (* b 64)
    start → (if (== lo 0) then (& -1 (! 3)) else -1)
    go → (λpi mask.
      p → (arrayi-get-ro ps pi)
      if (== p 0)
      then mask
      else (go (+ pi 1) (mark-prime p lo mask)))
    (go 0 start))

  block-count → (λb. (popcount (block-mask b)))

  chunk-count → (λp c.
    start → (* c chunk-size)
    stop → (if (< (+ start chunk-size) blocks)
            then (+ start chunk-size)
            else blocks)
    go → (λb acc.
      if (>= b stop)
      then acc
      else (go (+ b 1) (+ acc (block-count b))))
    (go start 0))

  chunk-counts → (arrayi-pmap-chunk chunk-count blocks chunk-size)

  find-chunk → (λi acc.
    if (>= i chunks)
    then [i, 0]
    else
      c → (arrayi-get chunk-counts i)
      if (<= n (+ acc c))
      then [i, (- n acc)]
      else (find-chunk (+ i 1) (+ acc c)))

  loc → (find-chunk 0 0)
  ch → (head loc)
  need → (head (tail loc))
  start-block → (* ch chunk-size)
  stop-block → (if (< (+ start-block chunk-size) blocks)
                then (+ start-block chunk-size)
                else blocks)

  find-block → (λb k.
    if (>= b stop-block)
    then [b, k]
    else
      c → (block-count b)
      if (<= k c)
      then [b, k]
      else (find-block (+ b 1) (- k c)))

  block-loc → (find-block start-block need)
  b → (head block-loc)
  k → (head (tail block-loc))

  nth-bit → (λmask k.
    go → (λi k.
      if (== k 0)
      then (- i 1)
      else
        if (> (& mask (shl 1 i)) 0)
        then (go (+ i 1) (- k 1))
        else (go (+ i 1) k))
    (go 0 k))

  (+ (* b 64) (nth-bit (block-mask b) k)))

(nth-prime-sieve 100000)
