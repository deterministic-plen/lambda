include "lib/complex.lambda"
include "lib/field.lambda"
N → 3
f0 → (field-new 2 N)
f1 → (field-set f0 2 N 0 0 1.0)
f2 → (field-set f1 2 N 1 0 2.0)
f3 → (field-set f2 2 N 0 1 3.0)
f4 → (field-set f3 2 N 1 1 4.0)
g → (field-map f4 2 N (λ p. (arrayf-get f4 p)))
total → (λ f: Array<Complex>. (arrayf-sum f))
c → (Complex::mul (Complex 1.0 2.0) (Complex 3.0 4.0))
[(field-get g 2 N 0 0), (field-get g 2 N 0 1), (total g), (Complex-re c), (Complex-im c)]
