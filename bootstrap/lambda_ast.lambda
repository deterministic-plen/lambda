include "lib/list.lambda"

data Node =
  NBlock (defs: [Node], data_decls: [Node], body: Node)
| NDef (name: Int, value: Node)
| NLam (params: [Int], param_types: [Int], param_borrows: [Int], body: Node)
| NApp (func: Node, args: [Node])
| NIf (cond: Node, then_: Node, else_: Node)
| NMatch (subject: Node, arms: [Node])
| NMatchArm (pattern: Int, binders: [Int], body: Node)
| NVar (sym: Int)
| NInt (value: Int)
| NFloat (value: Float)
| NBool (value: Bool)
| NString (lit: Int)
| NEnum (type_id: Int, tag: Int)
| NBorrow (value: Node)
| NDataDecl (name: Int, params: [Int], variants: [Node])
| NDataVariant (name: Int, tag: Int, fields: [Node])
| NDataField (name: Int, type_id: Int)
| NDataConstr (data_name: Int, tag: Int, variant: Int, args: [Node])
| NSumConstr (type_id: Int, variant: Int, tag: Int, args: [Node])
| NRecord (type_id: Int, args: [Node])
| NRecordField (value: Node, field: Int)

node-children → (λn:Node.
  match n with
    NBlock defs data_decls body:
      (append defs (append data_decls (cons body nil)))
  | NDef name value: (cons value nil)
  | NLam params types borrows body: (cons body nil)
  | NApp func args: (cons func args)
  | NIf cond then_ else_: (cons cond (cons then_ (cons else_ nil)))
  | NMatch subject arms: (cons subject arms)
  | NMatchArm pattern binders body: (cons body nil)
  | NBorrow value: (cons value nil)
  | NDataDecl name params variants: variants
  | NDataVariant name tag fields: fields
  | NDataConstr data_name tag variant args: args
  | NSumConstr type_id variant tag args: args
  | NRecord type_id args: args
  | NRecordField value field: (cons value nil)
  | NVar sym: nil
  | NInt value: nil
  | NFloat value: nil
  | NBool value: nil
  | NString lit: nil
  | NEnum type_id tag: nil
  | NDataField name type_id: nil
)

node-walk → (λn:Node.
  (node-children n)
)