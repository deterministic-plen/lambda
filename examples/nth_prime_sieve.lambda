; Chunked segmented sieve of Eratosthenes.
; Each block of 64 numbers is an independent 64-bit mask; base primes are
; shared read-only.  There is no inter-thread mutation or communication.
include "lib/prime.lambda"

nth-prime-sieve → (λn.
  limit → (upper-bound n)
  root → (float->int (√ (int->float limit)))
  ps → (immortalize (base-primes root))
  blocks → (float->int (⊘ (⊕ (int->float limit) 63.0) 64.0))

  mark-all → (λprimes lo mask.
    if (empty? primes)
    then mask
    else
      p → (head primes)
      p2 → (⊗ p p)
      rem → (⊙ lo p)
      first0 → (if (≡ rem 0) then lo else (⊕ lo (⊖ p rem)))
      first → (if (≺ first0 p2) then p2 else first0)
      mark → (λoff mask.
        if (≽ off 64)
        then mask
        else (mark (⊕ off p) (& mask (! (shl 1 off)))))
      (mark-all (tail primes) lo (mark (⊖ first lo) mask)))

  block → (λp b.
    lo → (⊗ b 64)
    start → (if (≡ lo 0) then (& -1 (! 3)) else -1)
    (mark-all ps lo start))

  nth-bit → (λmask k.
    go → (λi k.
      if (≡ k 0)
      then (⊖ i 1)
      else
        if (≻ (& mask (shl 1 i)) 0)
        then (go (⊕ i 1) (⊖ k 1))
        else (go (⊕ i 1) k))
    (go 0 k))

  get → (λi xs.
    if (≡ i 0) then (head xs) else (get (⊖ i 1) (tail xs)))

  masks → (pmap block (range 0 blocks))
  counts → (map popcount masks)
  loc → (find-block counts n)
  b → (head loc)
  k → (head (tail loc))
  (⊕ (⊗ b 64) (nth-bit (get b masks) k)))

(nth-prime-sieve 670000)
