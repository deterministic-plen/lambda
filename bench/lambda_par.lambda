; Benchmark-only wrapper: parallel trial-division block counting, repeated 3x.
include "lib/prime.lambda"

nth-prime-par → (λn.
  limit → (upper-bound n)
  blocks → (float->int (/ (+ (int->float limit) 65535.0) 65536.0))
  counts → (pmap count-block (range 0 blocks))
  loc → (find-block counts n)
  b → (head loc)
  k → (head (tail loc))
  (find-in-block b k))

run → (λk.
  if (== k 0)
  then 0
  else (+ (nth-prime-par 670000) (run (- k 1))))

(run 3)
