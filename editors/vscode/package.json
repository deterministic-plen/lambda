{
  "name": "lambda-language",
  "displayName": "Lambda",
  "description": "Lambda language support: syntax highlighting, completion, qualified names",
  "version": "0.1.0",
  "publisher": "lambda",
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:lambda"
  ],
  "engines": {
    "vscode": "^1.60.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "lambda",
    "functional"
  ],
  "contributes": {
    "languages": [
      {
        "id": "lambda",
        "aliases": [
          "Lambda",
          "lambda"
        ],
        "extensions": [
          ".lambda"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "lambda",
        "scopeName": "source.lambda",
        "path": "./syntaxes/lambda.tmLanguage.json"
      }
    ],
    "configurationDefaults": {
      "[lambda]": {
        "editor.wordBasedSuggestions": "off"
      }
    }
  },
    "iconThemes": [
      {
        "id": "lambda-icons",
        "label": "Lambda Theme",
        "path": "./icons/lambda-icon-theme.json"
      }
    ]
}