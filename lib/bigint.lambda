; Pure-Lambda arbitrary-precision unsigned integers.
;
; Representation: one arrayi per number.
;   a[0] = number of limbs
;   a[1 .. n] = little-endian base-1e9 limbs
; Unused capacity is zero.  Operations return fresh arrays; inputs are read-only
; except for the explicit `!` in-place variants.
; All limb products fit in i64 because (1e9-1)^2 plus a carry is < 1e18.

base → 1000000000
karatsuba-cutoff → 50
square-cutoff → 52

bi-zero → (λcap. (arrayi (+ cap 1) 0))
bi-len → (λ&a. (arrayi-get a 0))
bi-get → (λ&a i. (arrayi-get a (+ i 1)))
bi-set → (λa i v. (arrayi-set a (+ i 1) v))
bi-set-len → (λa n. (arrayi-set a 0 n))

bi-trim → (λa n.
  if (== n 0)
  then (arrayi-set a 0 0)
  else if (== 0 (arrayi-get a n))
  then (bi-trim a (- n 1))
  else (arrayi-set a 0 n))

bi-from-int → (λcap x.
  if (== x 0)
  then (bi-zero cap)
  else
    r → (bi-zero cap)
    (arrayi-set (arrayi-set r 1 x) 0 1))

bi-add → (λa b cap.
  al → (bi-len a)
  bl → (bi-len b)
  n → (if (> al bl) then al else bl)
  go → (λi carry r.
    if (>= i n)
    then
      if (== carry 0)
      then (arrayi-set r 0 n)
      else (arrayi-set (arrayi-set r (+ n 1) carry) 0 (+ n 1))
    else
      av → (if (< i al) then (arrayi-get a (+ i 1)) else 0)
      bv → (if (< i bl) then (arrayi-get b (+ i 1)) else 0)
      s → (+ av (+ bv carry))
      (go (+ i 1) (/ s base) (arrayi-set r (+ i 1) (% s base))))
  (go 0 0 (bi-zero cap)))

bi-add! → (λa b.
  al → (bi-len a)
  bl → (bi-len b)
  n → (if (> al bl) then al else bl)
  go → (λi carry r.
    if (>= i n)
    then
      if (== carry 0)
      then (arrayi-set r 0 n)
      else (arrayi-set (arrayi-set r (+ n 1) carry) 0 (+ n 1))
    else
      av → (arrayi-get r (+ i 1))
      bv → (if (< i bl) then (arrayi-get b (+ i 1)) else 0)
      s → (+ av (+ bv carry))
      (go (+ i 1) (/ s base) (arrayi-set r (+ i 1) (% s base))))
  (go 0 0 a))

bi-sub → (λa b cap.
  al → (bi-len a)
  bl → (bi-len b)
  go → (λi borrow r.
    if (>= i al)
    then (bi-trim r al)
    else
      av → (arrayi-get a (+ i 1))
      bv → (if (< i bl) then (arrayi-get b (+ i 1)) else 0)
      d → (- (- av bv) borrow)
      if (< d 0)
      then (go (+ i 1) 1 (arrayi-set r (+ i 1) (+ d base)))
      else (go (+ i 1) 0 (arrayi-set r (+ i 1) d)))
  (go 0 0 (bi-zero cap)))

bi-sub! → (λa b.
  al → (bi-len a)
  bl → (bi-len b)
  go → (λi borrow r.
    if (>= i al)
    then (bi-trim r al)
    else
      av → (arrayi-get r (+ i 1))
      bv → (if (< i bl) then (arrayi-get b (+ i 1)) else 0)
      d → (- (- av bv) borrow)
      if (< d 0)
      then (go (+ i 1) 1 (arrayi-set r (+ i 1) (+ d base)))
      else (go (+ i 1) 0 (arrayi-set r (+ i 1) d)))
  (go 0 0 a))

bi-slice → (λa start count cap.
  go → (λi r.
    if (>= i count)
    then (bi-trim r count)
    else (go (+ i 1) (arrayi-set r (+ i 1) (arrayi-get a (+ (+ start i) 1)))))
  (go 0 (bi-zero cap)))

bi-carry-add → (λr k carry.
  if (== carry 0)
  then r
  else
    cur → (+ (arrayi-get r (+ k 1)) carry)
    (bi-carry-add
      (arrayi-set r (+ k 1) (% cur base))
      (+ k 1)
      (/ cur base)))

bi-add-range → (λa aoff alen b boff blen cap.
  n → (if (> alen blen) then alen else blen)
  go → (λi carry r.
    if (>= i n)
    then
      if (== carry 0)
      then (arrayi-set r 0 n)
      else (arrayi-set (arrayi-set r (+ n 1) carry) 0 (+ n 1))
    else
      av → (if (< i alen)
            then (arrayi-get a (+ (+ aoff i) 1))
            else 0)
      bv → (if (< i blen)
            then (arrayi-get b (+ (+ boff i) 1))
            else 0)
      s → (+ av (+ bv carry))
      (go (+ i 1) (/ s base) (arrayi-set r (+ i 1) (% s base))))
  (go 0 0 (bi-zero cap)))

bi-mul-school-range → (λa aoff alen b boff blen cap.
  outer → (λi r.
    if (>= i alen)
    then (bi-trim r (+ alen blen))
    else
      ai → (arrayi-get a (+ (+ aoff i) 1))
      inner → (λj carry r.
        if (>= j blen)
        then (bi-carry-add r (+ i blen) carry)
        else
          k → (+ i j)
          bj → (arrayi-get b (+ (+ boff j) 1))
          rk → (arrayi-get r (+ k 1))
          cur → (+ rk (+ (* ai bj) carry))
          (inner (+ j 1) (/ cur base) (arrayi-set r (+ k 1) (% cur base))))
      (outer (+ i 1) (inner 0 0 r)))
  (outer 0 (bi-zero cap)))

bi-add-shift → (λdst src shift.
  sl → (bi-len src)
  prop → (λr k carry.
    if (== carry 0)
    then r
    else
      cur → (+ (arrayi-get r (+ k 1)) carry)
      (prop
        (arrayi-set r (+ k 1) (% cur base))
        (+ k 1)
        (/ cur base)))
  go → (λi carry r.
    if (>= i sl)
    then (prop r (+ shift sl) carry)
    else
      k → (+ shift i)
      cur → (+ (arrayi-get r (+ k 1))
               (+ (arrayi-get src (+ i 1)) carry))
      (go (+ i 1) (/ cur base) (arrayi-set r (+ k 1) (% cur base))))
  (go 0 0 dst))

bi-square-school-range → (λa aoff alen cap.
  r → (bi-zero cap)
  outer → (λi r.
    if (>= i alen)
    then (bi-trim r (+ alen alen))
    else
      ai → (arrayi-get a (+ (+ aoff i) 1))
      ai2 → (* 2 ai)
      diag → (* ai ai)
      cur → (+ (arrayi-get r (+ (+ i i) 1)) diag)
      r1 → (arrayi-set r (+ (+ i i) 1) (% cur base))
      carry1 → (/ cur base)
      inner → (λj carry r.
        if (>= j alen)
        then (bi-carry-add r (+ i alen) carry)
        else
          k → (+ i j)
          aj → (arrayi-get a (+ (+ aoff j) 1))
          rk → (arrayi-get r (+ k 1))
          cur2 → (+ rk (+ (* ai2 aj) carry))
          (inner (+ j 1) (/ cur2 base)
                  (arrayi-set r (+ k 1) (% cur2 base))))
      (outer (+ i 1) (inner (+ i 1) carry1 r1)))
  (outer 0 (bi-zero cap)))

bi-square-range → (λa aoff alen cap.
  if (< alen square-cutoff)
  then (bi-square-school-range a aoff alen cap)
  else
    m → (/ alen 2)
    ah → (- alen m)
    z0 → (bi-square-range a aoff m (+ (+ m m) 2))
    z2 → (bi-square-range a (+ aoff m) ah (+ (+ ah ah) 2))
    sm → (if (> m ah) then m else ah)
    sa → (bi-add-range a aoff m a (+ aoff m) ah (+ sm 2))
    z1 → (bi-square-range sa 0 (bi-len sa)
                         (+ (+ (bi-len sa) (bi-len sa)) 2))
    z1a → (bi-sub! z1 z0)
    z1b → (bi-sub! z1a z2)
    r → (bi-zero cap)
    r1 → (bi-add-shift r z0 0)
    r2 → (bi-add-shift r1 z1b m)
    r3 → (bi-add-shift r2 z2 (+ m m))
    (bi-trim r3 cap))

bi-square → (λa cap.
  (bi-toom-square-range a 0 (bi-len a) cap))

bi-mul-range → (λa aoff alen b boff blen cap.
  mn → (if (< alen blen) then alen else blen)
  if (< mn karatsuba-cutoff)
  then (bi-mul-school-range a aoff alen b boff blen cap)
  else
    m → (/ mn 2)
    ah → (- alen m)
    bh → (- blen m)
    z0 → (bi-mul-range a aoff m b boff m (+ (+ m m) 2))
    z2 → (bi-mul-range a (+ aoff m) ah b (+ boff m) bh (+ (+ ah bh) 2))
    sm → (if (> m ah) then m else ah)
    sn → (if (> m bh) then m else bh)
    sa → (bi-add-range a aoff m a (+ aoff m) ah (+ sm 2))
    sb → (bi-add-range b boff m b (+ boff m) bh (+ sn 2))
    z1 → (bi-mul-range sa 0 (bi-len sa) sb 0 (bi-len sb)
                      (+ (+ (bi-len sa) (bi-len sb)) 2))
    z1a → (bi-sub! z1 z0)
    z1b → (bi-sub! z1a z2)
    r → (bi-zero cap)
    r1 → (bi-add-shift r z0 0)
    r2 → (bi-add-shift r1 z1b m)
    r3 → (bi-add-shift r2 z2 (+ m m))
    (bi-trim r3 cap))

toom-cutoff → 220

bi-slice-pad → (λa start count cap.
  alen → (bi-len a)
  go → (λi r.
    if (>= i count)
    then (bi-trim r count)
    else
      idx → (+ start i)
      v → (if (< idx alen) then (arrayi-get a (+ idx 1)) else 0)
      (go (+ i 1) (arrayi-set r (+ i 1) v)))
  (go 0 (bi-zero cap)))

bi-scale-small → (λa k cap.
  n → (bi-len a)
  go → (λi carry r.
    if (>= i n)
    then
      if (== carry 0)
      then (arrayi-set r 0 n)
      else (arrayi-set (arrayi-set r (+ n 1) carry) 0 (+ n 1))
    else
      cur → (+ (* (arrayi-get a (+ i 1)) k) carry)
      (go (+ i 1) (/ cur base) (arrayi-set r (+ i 1) (% cur base))))
  (go 0 0 (bi-zero cap)))

bi-div-small → (λa k cap.
  n → (bi-len a)
  go → (λi rem r.
    if (== i 0)
    then (bi-trim r n)
    else
      cur → (+ (* rem base) (arrayi-get a i))
      q → (/ cur k)
      rem2 → (% cur k)
      (go (- i 1) rem2 (arrayi-set r i q)))
  (go n 0 (bi-zero cap)))

bi-toom-interp → (λz0 z1 z2 z3 z4 m cap.
  s1 → (bi-sub (bi-sub z1 z0 cap) z4 cap)
  s2a → (bi-sub (bi-sub z2 z0 cap) (bi-scale-small z4 16 cap) cap)
  s2 → (bi-div-small s2a 2 cap)
  s3a → (bi-sub (bi-sub z3 z0 cap) (bi-scale-small z4 81 cap) cap)
  s3 → (bi-div-small s3a 3 cap)
  c3 → (bi-div-small (bi-sub (bi-add s3 s1 cap) (bi-scale-small s2 2 cap) cap) 2 cap)
  c2 → (bi-sub (bi-sub s2 s1 cap) (bi-scale-small c3 3 cap) cap)
  c1 → (bi-sub (bi-sub s1 c2 cap) c3 cap)
  r → (bi-zero cap)
  r1 → (bi-add-shift r z0 0)
  r2 → (bi-add-shift r1 c1 m)
  r3 → (bi-add-shift r2 c2 (* 2 m))
  r4 → (bi-add-shift r3 c3 (* 3 m))
  r5 → (bi-add-shift r4 z4 (* 4 m))
  (bi-trim r5 cap))

bi-toom-mul-range → (λa aoff alen b boff blen cap.
  mn → (if (< alen blen) then blen else alen)
  if (< mn toom-cutoff)
  then (bi-mul-range a aoff alen b boff blen cap)
  else
    m → (/ (+ mn 2) 3)
    pcap → (+ m 4)
    zcap → (+ (* 2 m) 8)
    a0 → (bi-slice-pad a aoff m pcap)
    a1 → (bi-slice-pad a (+ aoff m) m pcap)
    a2 → (bi-slice-pad a (+ aoff (* 2 m)) m pcap)
    b0 → (bi-slice-pad b boff m pcap)
    b1 → (bi-slice-pad b (+ boff m) m pcap)
    b2 → (bi-slice-pad b (+ boff (* 2 m)) m pcap)
    p1 → (bi-add (bi-add a0 a1 pcap) a2 pcap)
    p2 → (bi-add (bi-add a0 (bi-scale-small a1 2 pcap) pcap)
                 (bi-scale-small a2 4 pcap) pcap)
    p3 → (bi-add (bi-add a0 (bi-scale-small a1 3 pcap) pcap)
                 (bi-scale-small a2 9 pcap) pcap)
    q1 → (bi-add (bi-add b0 b1 pcap) b2 pcap)
    q2 → (bi-add (bi-add b0 (bi-scale-small b1 2 pcap) pcap)
                 (bi-scale-small b2 4 pcap) pcap)
    q3 → (bi-add (bi-add b0 (bi-scale-small b1 3 pcap) pcap)
                 (bi-scale-small b2 9 pcap) pcap)
    z0 → (bi-toom-mul-range a0 0 (bi-len a0) b0 0 (bi-len b0) zcap)
    z1 → (bi-toom-mul-range p1 0 (bi-len p1) q1 0 (bi-len q1) zcap)
    z2 → (bi-toom-mul-range p2 0 (bi-len p2) q2 0 (bi-len q2) zcap)
    z3 → (bi-toom-mul-range p3 0 (bi-len p3) q3 0 (bi-len q3) zcap)
    z4 → (bi-toom-mul-range a2 0 (bi-len a2) b2 0 (bi-len b2) zcap)
    (bi-toom-interp z0 z1 z2 z3 z4 m cap))

bi-toom-square-range → (λa aoff alen cap.
  if (< alen toom-cutoff)
  then (bi-square-range a aoff alen cap)
  else
    m → (/ (+ alen 2) 3)
    pcap → (+ m 4)
    zcap → (+ (* 2 m) 8)
    a0 → (bi-slice-pad a aoff m pcap)
    a1 → (bi-slice-pad a (+ aoff m) m pcap)
    a2 → (bi-slice-pad a (+ aoff (* 2 m)) m pcap)
    p1 → (bi-add (bi-add a0 a1 pcap) a2 pcap)
    p2 → (bi-add (bi-add a0 (bi-scale-small a1 2 pcap) pcap)
                 (bi-scale-small a2 4 pcap) pcap)
    p3 → (bi-add (bi-add a0 (bi-scale-small a1 3 pcap) pcap)
                 (bi-scale-small a2 9 pcap) pcap)
    z0 → (bi-toom-square-range a0 0 (bi-len a0) zcap)
    z1 → (bi-toom-square-range p1 0 (bi-len p1) zcap)
    z2 → (bi-toom-square-range p2 0 (bi-len p2) zcap)
    z3 → (bi-toom-square-range p3 0 (bi-len p3) zcap)
    z4 → (bi-toom-square-range a2 0 (bi-len a2) zcap)
    (bi-toom-interp z0 z1 z2 z3 z4 m cap))

bi-mul → (λa b cap.
  (bi-toom-mul-range a 0 (bi-len a) b 0 (bi-len b) cap))

bi-fib → (λn cap.
  if (== n 0)
  then (bi-from-int cap 0)
  else
    a → (bi-from-int cap 0)
    b → (bi-from-int cap 1)
    high → (λp. if (<= (* p 2) n) then (high (* p 2)) else p)
    p0 → (high 1)
    go → (λ p a b.
      if (== p 0)
      then a
      else
        bit → (% (/ n p) 2)
        need → (+ (+ (bi-len a) (bi-len b)) 4)
        work-cap → (if (< cap need) then cap else need)
        d → (bi-add! (bi-square a work-cap) (bi-square b work-cap))
        t → (bi-sub! (bi-add! b b) a)
        c → (bi-mul a t work-cap)
        if (== bit 0)
        then (go (/ p 2) c d)
        else (go (/ p 2) d (bi-add! c d)))
    (go p0 a b))

bi-pad9 → (λs.
  go → (λs k.
    if (>= k 9)
    then s
    else (go (str-append "0" s) (+ k 1)))
  (go s (str-len s)))

bi-print → (λa.
  n → (bi-len a)
  if (== n 0)
  then (print "0")
  else
    first → (print (int->str (arrayi-get a n)))
    go → (λi.
      if (< i 0)
      then ""
      else
        s → (print (bi-pad9 (int->str (arrayi-get a (+ i 1)))))
        (go (- i 1)))
    (go (- n 2)))
