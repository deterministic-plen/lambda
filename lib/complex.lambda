type Complex (re: Float, im: Float) ;Rectangular form
type PolarComplex (r:Float, arg:Float)
; Absolute-value extrema used by Complex::modulus.  The old names `max`/`min`
; were ordinary globals over *absolute values*, so merely including this module
; clashed with any program (or other library) that defined its own `max`/`min`.
; The prefixed names keep that namespace free.
cabs-max → (λa: Float b: Float. if (>= (abs a) (abs b)) then (abs a) else (abs b))
cabs-min → (λa: Float b: Float. if (>= (abs a) (abs b)) then (abs b) else (abs a))
Complex::add → (λa: Complex b: Complex.
  (Complex (+ a_re b_re) (+ a_im b_im)))

Complex::scale → (λa: Complex k: Float.
  (Complex (* a_re k) (* a_im k)))

Complex::sub → (λa: Complex b: Complex.
  (Complex (- a_re b_re) (- a_im b_im)))

Complex::mul → (λa: Complex b: Complex.
  (Complex (- (* a_re b_re) (* a_im b_im)) (+ (* a_re b_im) (* a_im b_re))))

Complex::arg → (λa: Complex.
    atan2 a_im a_re
)

Complex::conj → (λa: Complex.
(Complex a_re (- 0.0 a_im))
)

; Overflow-safe modulus.  ratio = min/max is 0/0 for zero, so zero is special
; cased; when max is infinite the result is infinite (and NaN input stays NaN).
Complex::modulus →(λa: Complex.
  m → (cabs-max a_re a_im)
  if (== m 0.0)
  then 0.0
  else if (not (< m 1.7976931348623157e308))
  then m
  else
    ratio → (/ (cabs-min a_re a_im) m)
    (* m (sqrt (+ 1.0 (* ratio ratio))))
)

Complex::toPolar → (λa: Complex.
    (PolarComplex (Complex::modulus a) (Complex::arg a))
)

; exp(a) = e^(a_re) * (cos(a_im) + i sin(a_im)).  The old code used
; cos/sin(Complex::arg a), i.e. the *angle of a*, which is only correct when
; a_im = 0.
Complex::exp → (λa: Complex.
  e → (exp a_re)
  (Complex (* e (cos a_im)) (* e (sin a_im)))
)

Complex::div → (λa: Complex b: Complex.
  if (and (== b_re 0.0) (== b_im 0.0))
  then (Complex (/ 0.0 0.0) (/ 0.0 0.0))
  else
    if (>= (abs b_re) (abs b_im))
    then
      r → (/ b_im b_re)
      d → (+ b_re (* b_im r))
      (Complex (/ (+ a_re (* a_im r)) d)
               (/ (- a_im (* a_re r)) d))
    else
      r → (/ b_re b_im)
      d → (+ b_im (* b_re r))
      (Complex (/ (+ (* a_re r) a_im) d)
               (/ (- (* a_im r) a_re) d))
)

Complex::recip → (λa: Complex. (Complex::div (Complex 1.0 0.0) a))

Complex::is-nan → (λa: Complex.
  (or (not (== a_re a_re)) (not (== a_im a_im))))

Complex::is-finite → (λa: Complex.
  (and (and (== a_re a_re) (== a_im a_im))
       (and (<= (abs a_re) 1.7976931348623157e308)
            (<= (abs a_im) 1.7976931348623157e308))))
