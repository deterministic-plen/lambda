;variance
varp → (λdata.
  N → (arrayf-length data)
  if (<= N 1)
  then 0.0
  else
    go → (λi mean m2.
      if (>= i N)
      then (/ m2 (int->float N))       ; population
      else
        x → (arrayf-get data i)
        delta → (- x mean)
        mean2 → (+ mean (/ delta (int->float (+ i 1))))
        delta2 → (- x mean2)
        (go (+ i 1) mean2 (+ m2 (* delta delta2))))
    (go 0 0.0 0.0)
)
;minimum float
minf → (λ&data. 
    go → (λiter &a m. if (>= iter (arrayf-length a)) then m else if (>= m (arrayf-get a iter)) then go (+ iter 1) a (arrayf-get a iter) else go (+ iter 1) a m)
    (go 0 data (arrayf-get data 0))
)

;maximum float
maxf → (λ&data.
    go → (λiter &a m.
    if (>= iter (arrayf-length a))
    then m
    else if (<= m (arrayf-get a iter))    
    then go (+ iter 1) a (arrayf-get a iter)
    else go (+ iter 1) a m
    )
    (go 0 data (arrayf-get data 0))
)