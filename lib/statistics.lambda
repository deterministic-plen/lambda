;variance
; `varp` returns 0.0 for an empty or one-element array.
varp → (λ&data.
  N → (arrayf-length data)
  if (<= N 1)
  then 0.0
  else
    go → (λi mean m2.
      if (>= i N)
      then (/ m2 (int->float N))       ; population
      else
        x → (arrayf-get data i)
        delta → (- x mean)
        mean2 → (+ mean (/ delta (int->float (+ i 1))))
        delta2 → (- x mean2)
        (go (+ i 1) mean2 (+ m2 (* delta delta2))))
    (go 0 0.0 0.0)
)
; minimum float.  NaN is ignored (like Python's math.fmin / NumPy's nanmin):
; comparing against NaN is always false, so a NaN would otherwise poison the
; result depending on its position.  An empty array, or an array that contains
; only NaN, returns 0.0 - the same "no data" value varp uses - instead of the
; out-of-bounds read the old first-element seed performed.
minf → (λ&data. 
    go → (λiter &a m found. 
      if (>= iter (arrayf-length a))
      then (if found then m else 0.0)
      else
        x → (arrayf-get a iter)
        if (== x x)
        then
          if found
          then (if (< x m) then (go (+ iter 1) a x true) else (go (+ iter 1) a m true))
          else (go (+ iter 1) a x true)
        else (go (+ iter 1) a m found))
    (go 0 data 0.0 false)
)

; maximum float; same NaN/empty rules as minf.
maxf → (λ&data.
    go → (λiter &a m found.
      if (>= iter (arrayf-length a))
      then (if found then m else 0.0)
      else
        x → (arrayf-get a iter)
        if (== x x)
        then
          if found
          then (if (> x m) then (go (+ iter 1) a x true) else (go (+ iter 1) a m true))
          else (go (+ iter 1) a x true)
        else (go (+ iter 1) a m found))
    (go 0 data 0.0 false)
)
