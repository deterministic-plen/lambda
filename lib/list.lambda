; Generic list helpers.  `map` itself is a primitive.

length → (λxs.
  go → (λacc rest.
    if (empty? rest)
    then acc
    else (go (+ acc 1) (tail rest)))
  (go 0 xs))

reverse → (λxs.
  go → (λacc rest.
    if (empty? rest)
    then acc
    else (go (cons (head rest) acc) (tail rest)))
  (go nil xs))

; `filter` and `append` are accumulator loops so that long lists do not grow
; the native stack: the recursive call is the whole body of `go` and `reverse`
; is already tail recursive.  A non-tail `(cons x (filter ...))` overflowed the
; compiler/runner stack at about 100k-300k elements.
filter → (λ p xs.
  go → (λacc rest.
    if (empty? rest)
    then (reverse acc)
    else if (p (head rest))
    then (go (cons (head rest) acc) (tail rest))
    else (go acc (tail rest)))
  (go nil xs))

foldl → (λf acc xs.
  if (empty? xs)
  then acc
  else (foldl f (f acc (head xs)) (tail xs)))

append → (λxs ys.
  ; Reverse xs, then push each element back onto ys: both loops are tail calls.
  go → (λacc rest.
    if (empty? rest)
    then acc
    else (go (cons (head rest) acc) (tail rest)))
  (go ys (reverse xs)))


; Membership test for a finite list.  This is the concise equivalent of
; Python's ``x in (a, b, c)`` for an ordinary Lambda list.
member → (λ x xs.
  if (empty? xs)
  then false
  else if (== x (head xs))
  then true
  else (member x (tail xs)))

; Python-style membership spelling, e.g. (in? c [a, b, c]).
in? → member
