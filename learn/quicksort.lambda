; Quicksort over persistent lists.  Lists are immutable, so the functional
; version is shorter and safer than the half-finished in-place prototype that
; used to live here; an array-based quicksort is in tests/arrays/arrayi_loop.
include "lib/list.lambda"

qsort → (λxs.
  if (empty? xs) then []
  else pivot → (head xs)
       rest → (tail xs)
       smaller → (filter (λx. (<= x pivot)) rest)
       larger → (filter (λx. (> x pivot)) rest)
       (append (qsort smaller) (cons pivot (qsort larger))))

(qsort [3, 1, 4, 1, 5, 9, 2, 6])
