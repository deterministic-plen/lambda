fizzbuzz → (λx. 
if == (% x 3) 0
then "fizz"
else if == (% x 5) 0
then "buzz"
else if (and (== (% x 5) 0) (== (% x 3) 0))
then "fizzbuzz"
else int->str x)
; Lambda supports the primitive ternary conditional.
; The syntax is always if (condition) then (statement) else (statement)

go→(λiter.
if >= iter 20 then ""
else
a→(println (fizzbuzz iter))
go (+ iter 1)
)
go 0
