; gray_scott.lambda -- Pi worker for Gray-Scott reaction-diffusion.
;
; All numerical work is ordinary Lambda: an explicit five-point Laplacian and
; the two Gray-Scott update equations.  There is no domain-specific primitive.
;
; State is one ArrayF containing U then V:
;   uv[0 .. N)      U
;   uv[N .. 2N)     V
;
; op 0 init(x)       seed the field
; op 1 step()        one Euler step, returns V
; op 2 snapshot()    return the current V

include "pi_worker.lambda"
include "pi_schema_GrayScott.lambda"

size → 512
N → (* size size)
DU → 0.16
DV → 0.08
FEED → 0.055
KILL → 0.062
DT → 1.0

; U=1, V=0 everywhere, then a 32x32 seed in the centre.
init-u → (λ i uv.
  if (>= i N)
  then (seed 0 uv)
  else (init-u (+ i 1) (arrayf-set uv i 1.0)))

seed → (λ k uv.
  if (>= k 256)
  then uv
  else
    x → (+ 248 (% k 16))
    y → (+ 248 (/ k 16))
    p → (+ (* y size) x)
    uv1 → (arrayf-set uv p 0.5)
    (seed (+ k 1) (arrayf-set uv1 (+ N p) 1.0)))

init-uv → (init-u 0 (arrayf (* 2 N) 0.0))

slice-go → (λ i out uv.
  if (>= i N)
  then out
  else (slice-go (+ i 1) (arrayf-set out i (arrayf-get uv (+ N i))) uv))

slice-v → (λ uv. (slice-go 0 (arrayf N 0.0) uv))

clamp01 → (λ x.
  if (< x 0.0) then 0.0
  else if (> x 1.0) then 1.0
  else x)

wrap → (λ v.
  if (< v 0) then (+ v size)
  else if (>= v size) then (- v size)
  else v)

u-at → (λ uv y x.
  (arrayf-get uv (+ (* (wrap y) size) (wrap x))))

v-at → (λ uv y x.
  (arrayf-get uv (+ N (+ (* (wrap y) size) (wrap x)))))

u-new → (λ uv p.
  y → (/ p size)
  x → (% p size)
  u → (u-at uv y x)
  v → (v-at uv y x)
  lap → (- (+ (+ (u-at uv y (- x 1)) (u-at uv y (+ x 1)))
              (+ (u-at uv (- y 1) x) (u-at uv (+ y 1) x)))
           (* 4.0 u))
  uvv → (* u (* v v))
  (clamp01 (+ u (* DT (+ (- (* DU lap) uvv) (* FEED (- 1.0 u)))))))

v-new → (λ uv p.
  y → (/ p size)
  x → (% p size)
  u → (u-at uv y x)
  v → (v-at uv y x)
  lap → (- (+ (+ (v-at uv y (- x 1)) (v-at uv y (+ x 1)))
              (+ (v-at uv (- y 1) x) (v-at uv (+ y 1) x)))
           (* 4.0 v))
  uvv → (* u (* v v))
  (clamp01 (+ v (* DT (+ (+ (* DV lap) uvv) (* (- FEED KILL) v))))))

compute → (λ uv.
  (arrayf-pmap (λ p.
    if (< p N) then (u-new uv p) else (v-new uv (- p N))) (* 2 N)))

step → (λ uv. (compute uv))

gs-loop → (λz uv.
  hd → (pi-next-call 0)
  corr → (arrayi-get hd 0)
  if (< corr 0)
  then 0
  else
    op → (arrayi-get hd 1)
    nargs → (arrayi-get hd 2)
    a → (pi-read-floats (arrayf nargs 0.0) 0 nargs)
    if (== op op-init)
    then
      w → (pi-reply-ok corr pi-empty)
      (gs-loop 0 init-uv)
    else if (== op op-step)
    then
      uv2 → (step uv)
      v → (slice-v uv2)
      w → (pi-reply-ok corr v)
      (gs-loop 0 uv2)
    else if (== op op-snapshot)
    then
      v → (slice-v uv)
      w → (pi-reply-ok corr v)
      (gs-loop 0 uv)
    else
      w → (pi-reply-err corr error-unknown_op 0 0 (- 0 1))
      (gs-loop 0 uv))

hello → (pi-hello schema-hi schema-lo 2)
(gs-loop 0 init-uv)
