; tile_shim.lambda -- protocol dispatch shared by Pi tile workers.
;
; A worker supplies four hooks and lets the shim handle requests, replies and
; the loop:
;
;   init    : (Int, Int, Int, Int, Int, Int) -> State
;   step    : State -> State
;   patch   : (State, ArrayF) -> State
;   snapshot: State -> ArrayF
;
; The step reply is the snapshot of the *new* state, matching the existing
; HeatTile / GrayTile protocols.  Unknown operations reply with the supplied
; error code.

include "pi_worker.lambda"

tile-shim → (λop-init op-step op-patch op-snapshot err hi lo version
              initial-state init-fn step-fn payload-fn patch-fn snapshot-fn.
  hello → (pi-hello hi lo version)
  loop → (λstate.
    hd → (pi-next-call 0)
    corr → (arrayi-get hd 0)
    if (< corr 0)
    then 0
    else
      op → (arrayi-get hd 1)
      nargs → (arrayi-get hd 2)
      a → (pi-read-floats (arrayf nargs 0.0) 0 nargs)
      if (== op op-init)
      then
        if (< nargs 6)
        then
          w → (pi-reply-err corr err 0 0 (- 0 1))
          (loop state)
        else
          ox → (float->int (arrayf-get a 0))
          oy → (float->int (arrayf-get a 1))
          r → (float->int (arrayf-get a 2))
          c → (float->int (arrayf-get a 3))
          gr → (float->int (arrayf-get a 4))
          gc → (float->int (arrayf-get a 5))
          state2 → (init-fn ox oy r c gr gc)
          w → (pi-reply-ok corr pi-empty)
          (loop state2)
      else if (== op op-step)
      then
        state2 → (step-fn state)
        payload → (payload-fn state2)
        w → (pi-reply-ok corr payload)
        (loop state2)
      else if (== op op-patch)
      then
        state2 → (patch-fn state a)
        w → (pi-reply-ok corr pi-empty)
        (loop state2)
      else if (== op op-snapshot)
      then
        w → (pi-reply-ok corr (snapshot-fn state))
        (loop state)
      else
        w → (pi-reply-err corr err 0 0 (- 0 1))
        (loop state))
  (loop initial-state))
